<?xml version="1.0" encoding="utf-8"?>
<!-- Adds a local feed serving the System.Formats.Cbor build from the dotnet/runtime repo
     (incremental chunked reading support, https://github.com/dotnet/runtime/issues/129718).
     Repack with: dotnet pack /tmp/cbor-pack/System.Formats.Cbor.Local.csproj -o ~/dev/runtime/artifacts/local-packages -->
<configuration>
  <packageSources>
    <add key="local-runtime-artifacts" value="/home/muhamoth/dev/runtime/artifacts/local-packages" />
  </packageSources>
</configuration>
